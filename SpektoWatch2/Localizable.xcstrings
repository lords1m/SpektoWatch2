        }
      }
    },
    "window_function.hamming.description" : {
      "comment" : "FFT window function help text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ähnlich wie Hann, aber bessere Seitenlappen-Unterdrückung auf Kosten von mehr Hauptlappen-Breite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Similar to Hann but better sidelobe suppression at the cost of a wider main lobe."
          }
        }
      }
    },
