    "window_function.rectangular.description" : {
      "comment" : "FFT window function help text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste Frequenzauflösung, aber starke spektrale Leckage. Geeignet wenn Signalfrequenz exakt auf FFT-Bin fällt."
