          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blackman"
          }
        }
      }
    },
    "window_function.flat_top.description" : {
      "comment" : "FFT window function help text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimiert für genaue Amplitudenmessung. Breitester Hauptlappen, aber präziseste Pegelwerte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimized for accurate amplitude measurement. Widest main lobe but most precise level readings."
          }
        }
      }
    },
    "window_function.flat_top.name" : {
