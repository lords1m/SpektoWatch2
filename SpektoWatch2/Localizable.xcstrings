    "window_function.blackman.description" : {
      "comment" : "FFT window function help text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr gute Leckage-Unterdrückung. Ideal für Breitbandanalyse mit schwachen Signalen neben starken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very good leakage suppression. Ideal for broadband analysis with weak signals beside strong ones."
          }
        }
      }
    },
    "window_function.blackman.name" : {
      "comment" : "FFT window function display name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blackman"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blackman"
          }
        }
      }
    },
    "window_function.blackman_harris.description" : {
      "comment" : "FFT window function help text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exzellente Leckage-Unterdrückung (-92 dB). Für präzise Amplitudenmessung bei bekannten Frequenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excellent leakage suppression (-92 dB). For precise amplitude measurement at known frequencies."
          }
        }
      }
    },
    "window_function.blackman_harris.name" : {
      "comment" : "FFT window function display name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blackman-Harris"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blackman-Harris"
          }
        }
      }
    },
    "window_function.flat_top.description" : {
      "comment" : "FFT window function help text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimiert für genaue Amplitudenmessung. Breitester Hauptlappen, aber präziseste Pegelwerte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimized for accurate amplitude measurement. Widest main lobe but most precise level readings."
          }
        }
      }
    },
    "window_function.flat_top.name" : {
      "comment" : "FFT window function display name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat Top"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat Top"
          }
        }
      }
    },
    "window_function.hamming.description" : {
      "comment" : "FFT window function help text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ähnlich wie Hann, aber bessere Seitenlappen-Unterdrückung auf Kosten von mehr Hauptlappen-Breite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Similar to Hann but better sidelobe suppression at the cost of a wider main lobe."
          }
        }
      }
    },
    "window_function.hamming.name" : {
      "comment" : "FFT window function display name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hamming"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hamming"
          }
        }
      }
    },
    "window_function.hann.description" : {
      "comment" : "FFT window function help text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guter Kompromiss zwischen Auflösung und Leckage. Standard für allgemeine Anwendungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good compromise between resolution and leakage. Default for general use."
          }
        }
      }
    },
    "window_function.hann.name" : {
      "comment" : "FFT window function display name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hann"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hann"
          }
        }
      }
    },
    "window_function.rectangular.description" : {
      "comment" : "FFT window function help text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste Frequenzauflösung, aber starke spektrale Leckage. Geeignet wenn Signalfrequenz exakt auf FFT-Bin fällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Best frequency resolution but strong spectral leakage. Suitable when the signal frequency lands exactly on an FFT bin."
          }
        }
      }
    },
    "window_function.rectangular.name" : {
      "comment" : "FFT window function display name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechteck"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rectangular"
          }
        }
      }
    }
