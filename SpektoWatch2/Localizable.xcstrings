    "window_function.blackman_harris.description" : {
      "comment" : "FFT window function help text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exzellente Leckage-Unterdrückung (-92 dB). Für präzise Amplitudenmessung bei bekannten Frequenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excellent leakage suppression (-92 dB). For precise amplitude measurement at known frequencies."
          }
        }
      }
    },
    "window_function.blackman_harris.name" : {
      "comment" : "FFT window function display name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blackman-Harris"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blackman-Harris"
          }
        }
      }
    },
    "window_function.blackman.description" : {
      "comment" : "FFT window function help text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr gute Leckage-Unterdrückung. Ideal für Breitbandanalyse mit schwachen Signalen neben starken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very good leakage suppression. Ideal for broadband analysis with weak signals beside strong ones."
          }
        }
      }
    },
    "window_function.blackman.name" : {
      "comment" : "FFT window function display name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
